{
  "name": "consistent.software",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6",
  "scripts": {
    "check-links": "remark --ignore-path .gitignore --frail --quiet --no-stdout ."
  },
  "devDependencies": {
    "remark-cli": "catalog:",
    "remark-gfm": "catalog:",
    "remark-lint-no-dead-urls": "catalog:",
    "remark-validate-links": "catalog:"
  },
  "remarkConfig": {
    "plugins": [
      "remark-gfm",
      "remark-validate-links",
      [
        "remark-lint-no-dead-urls",
        {
          "deadOrAliveOptions": {
            "timeout": 15000,
            "maxRetries": 2
          }
        }
      ]
    ]
  }
}
