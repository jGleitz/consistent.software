{
  "name": "consistent.software",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2+sha512.25a51652a196785af5f28bda6dfe8dc582ebefa4ac1d180221ce1390231c5fb76637822ea4b6e4633ce74acdcb0a77f725af11bad38177fdeddaee818a955cb9",
  "scripts": {
    "check-links": "remark --ignore-path .gitignore --frail --quiet --no-stdout ."
  },
  "devDependencies": {
    "remark-cli": "catalog:",
    "remark-gfm": "catalog:",
    "remark-lint-no-dead-urls": "catalog:",
    "remark-validate-links": "catalog:"
  },
  "remarkConfig": {
    "plugins": [
      "remark-gfm",
      "remark-validate-links",
      [
        "remark-lint-no-dead-urls",
        {
          "deadOrAliveOptions": {
            "timeout": 15000,
            "maxRetries": 2
          }
        }
      ]
    ]
  }
}
