{
  "name": "consistent.software",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61",
  "scripts": {
    "check-links": "remark --ignore-path .gitignore --frail --quiet --no-stdout ."
  },
  "devDependencies": {
    "remark-cli": "catalog:",
    "remark-gfm": "catalog:",
    "remark-lint-no-dead-urls": "catalog:",
    "remark-validate-links": "catalog:"
  },
  "remarkConfig": {
    "plugins": [
      "remark-gfm",
      "remark-validate-links",
      [
        "remark-lint-no-dead-urls",
        {
          "deadOrAliveOptions": {
            "timeout": 15000,
            "maxRetries": 2
          }
        }
      ]
    ]
  }
}
