{
  /* Simulate this configuration locally by running:
       podman run --rm \
           --mount type=bind,src="$(pwd)",dst=/repo \
           --workdir /repo \
           --user 0 \
           --env RENOVATE_GITHUB_COM_TOKEN=$(secret-tool lookup service renovate-dry-run) \
           --env LOG_LEVEL=debug \
           renovate/renovate --dry-run=full --platform=local
    */
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>jGleitz/renovate-config:default.json5"],
  packageRules: [
    {
      // VitePress 2.0.0-alpha.20 requires markdown-it-mathjax3@^4.
      // Recheck VitePress's peerDependencies when upgrading VitePress and
      // update or remove this restriction once newer plugin versions are supported.
      matchManagers: ["npm"],
      matchPackageNames: ["markdown-it-mathjax3"],
      allowedVersions: "^4",
    },
    {
      // The shared configuration looks up "npm:" entries of Gradle version catalogs on npm and strips
      // the prefix from their names. Renovate would then pass the bare name, for example "prettier",
      // to Gradle's --update-locks, which only accepts <group>:<artifact>. Gradle doesn't resolve
      // these entries, so they appear in no Gradle lockfile and there is nothing to update.
      matchManagers: ["gradle"],
      matchDatasources: ["npm"],
      skipArtifactsUpdate: true,
    },
  ],
  customManagers: [
    // ktlint("1.8.0") inside a spotless {} block
    {
      customType: "regex",
      managerFilePatterns: ["**/*.gradle.kts"],
      matchStrings: ['ktlint\\("(?<currentValue>[\\d.]+)"\\)'],
      depNameTemplate: "ktlint",
      packageNameTemplate: "com.pinterest.ktlint:ktlint-bom",
      datasourceTemplate: "maven",
      versioningTemplate: "gradle",
    },
    // prettier("3.8.1") inside a spotless {} block
    {
      customType: "regex",
      managerFilePatterns: ["**/*.gradle.kts"],
      matchStrings: ['prettier\\("(?<currentValue>[\\d.]+)"\\)'],
      datasourceTemplate: "npm",
      depTypeTemplate: "devDependencies",
      depNameTemplate: "prettier",
    },
    // prettier(mapOf(
    //   "prettier" to "3.6.0",
    //   "prettier-plugin-properties" to "0.3.1"
    // ))
    {
      customType: "regex",
      managerFilePatterns: ["**/*.gradle.kts"],
      matchStringsStrategy: "recursive",
      matchStrings: [
        "prettier\\([^)]+\\)",
        '"(?<depName>[^"]+)"\\s*to\\s*"(?<currentValue>[\\d.]+)"',
      ],
      datasourceTemplate: "npm",
      depTypeTemplate: "devDependencies",
    },
  ],
}
